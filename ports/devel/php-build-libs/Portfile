PortSystem          1.0

name                php-build-libs
version             1.0

categories          devel
maintainers         openmaintainer
license             Apache-2

description         Library dependencies for private build PHP
long_description    ${description}

distfiles
use_configure       no
build               {}
destroot {
    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 644 ${filespath}/dummy.txt ${destroot}${docdir}/dummy.txt
}

depends_lib         port:php-build-essentials \
                    port:bzip2 \
                    port:curl \
                    port:freetype \
                    port:gmp \
                    port:icu \
                    port:libavif \
                    port:libedit \
                    port:libffi \
                    port:libheif \
                    port:libiconv \
                    port:libjpeg-turbo \
                    port:libpng \
                    port:libsodium \
                    port:libxml2 \
                    port:libxslt \
                    port:libzip \
                    port:ncurses \
                    port:oniguruma6 \
                    port:openssl3 \
                    port:postgresql18 \
                    port:sqlite3 \
                    port:webp \
                    port:zlib
