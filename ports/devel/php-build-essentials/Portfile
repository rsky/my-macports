PortSystem          1.0

name                php-build-essentials
version             1.0

categories          devel
maintainers         openmaintainer
license             Apache-2

description         Build tools for private build PHP
long_description    ${description}

distfiles
use_configure       no
build               {}
destroot {
    set docdir ${prefix}/share/doc/${name}
    xinstall -d ${destroot}${docdir}
    xinstall -m 644 ${filespath}/dummy.txt ${destroot}${docdir}/dummy.txt
}

depends_lib         port:autoconf \
                    port:automake \
                    port:bison \
                    port:libtool \
                    port:pkgconfig \
                    port:re2c
